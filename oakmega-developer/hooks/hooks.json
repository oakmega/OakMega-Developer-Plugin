{
  "description": "OakMega Developer plugin 版本守門：session 開始時、以及使用者每次送出訊息時，比對 GitHub 版本，落後就自動更新並提示重啟。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/version-check.sh\"",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/version-check.sh\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
